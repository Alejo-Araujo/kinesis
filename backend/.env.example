# ============================================================
#  Plantilla de variables de entorno - gestionFisioterapia
#  Copiar este archivo a ".env" y completar los valores reales.
#     cp .env.example .env
#  El archivo .env NO se versiona (esta en .gitignore).
#  Usar los MISMOS nombres de variable en desarrollo y en produccion,
#  cambiando solo los valores.
# ============================================================

# Entorno de ejecucion: development | production
# En produccion definir NODE_ENV=production (silencia logs de depuracion).
NODE_ENV=development

# Puerto en el que escucha el backend (sirve API + frontend).
# Desarrollo: 3000    |    Produccion: p.ej. 50001
PORT=3000

# ---- Base de datos MySQL/MariaDB ----
DB_HOST=localhost
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_NAME=kinesis
DB_PORT=3306

# ---- Autenticacion ----
# Secreto para firmar/verificar los JWT. Generar uno largo y aleatorio, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

# ---- Twilio (envio de SMS) ----
# Completar solo si se activa el envio de SMS.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+10000000000

# ---- Logs (opcional) ----
# Nivel minimo: info (por defecto) | debug (mas detalle) | warn | error.
# LOG_LEVEL=info
# Carpeta de los logs (por defecto backend/logs). Archivos: combined-*, error-*, auditoria-*, fatal.log
# LOG_DIR=
# Diagnostico de caidas: cada cuanto se registra el LATIDO (memoria, CPU, requests, base) y
# a partir de cuantos ms un request se registra como REQUEST_LENTO.
# DIAG_INTERVALO_MS=60000
# DIAG_REQUEST_LENTO_MS=5000

# ---- Utilidad opcional ----
# Password en texto plano para el script hash.password.js
# (alternativa a pasarlo por argumento: node hash.password.js <password>).
# PASSWORD_TO_HASH=
